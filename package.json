{
  "name": "@vheins/opencode-9router",
  "version": "0.9.1",
  "description": "OpenCode plugin provider for 9Router — FREE AI Router & Token Saver. 40+ providers, 100+ models.",
  "author": "vheins",
  "keywords": [
    "opencode",
    "9router",
    "ai-router",
    "llm",
    "provider",
    "openai-compatible",
    "token-saver",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vheins/opencode-9router.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "server.js",
    "README.md",
    "README.id.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node test-minimal.mjs && node test-limit.mjs && node test-combo.mjs && node test-v2.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.182",
    "@opencode-ai/sdk": "^1.0.182",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "toml": "^4.2.0"
  }
}
